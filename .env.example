VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Vercel KV / Upstash Redis (required for share links)
KV_REST_API_URL=https://your-redis.upstash.io
KV_REST_API_TOKEN=your-kv-token

# Billing (server-only — set in Vercel env, not VITE_*)
# Leave unset to skip paywall (full access for everyone).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# Set to 1 for PayFast sandbox
PAYFAST_SANDBOX=1
# Comma-separated emails that never need to pay (you / testers)
BILLING_EXEMPT_EMAILS=you@example.com
